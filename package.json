{
  "name": "fanza-tiktok-affiliate",
  "version": "1.0.0",
  "scripts": {
    "metadata": "node scripts/fetch-metadata.js",
    "resolve": "node scripts/resolve-mp4.js",
    "build": "node scripts/build-search.js && node scripts/build-pages.js",
    "update": "powershell -ExecutionPolicy Bypass -File scripts/update-videos.ps1",
    "schedule": "powershell -ExecutionPolicy Bypass -File scripts/register-task.ps1",
    "tweet": "node scripts/tweet.js",
    "tweet:dry": "node scripts/tweet.js --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "puppeteer-core": "^24.43.0"
  }
}
